   "source": [
    "from typing import Generic, TypeVar\n",
    "\n",
    "# Define a generic type variable\n",
    "T = TypeVar(\"T\")\n",
    "\n",
    "\n",
    "class Inventory(Generic[T]):\n",
    "    def __init__(self):\n",
    "        self.items: list[T] = []\n",
    "\n",
    "    # Store an item\n",
    "    def store(self, item: T):\n",
    "        self.items.append(item)\n",
    "\n",
    "    # Retrieve all stored items\n",
    "    def retrieve(self) -> list[T]:\n",
    "        return self.items\n",
    "\n",
    "    # Display the type and value of each item\n",
    "    def display(self):\n",
    "        if not self.items:\n",
    "            print(\"Inventory is empty.\")\n",
    "            return\n",
    "\n",
    "        print(f\"Item Type: {type(self.items[0]).__name__}\")\n",
    "        print(\"Items:\")\n",
    "        for item in self.items:\n",
    "            print(f\" - {item}\")\n",
    "\n",
    "\n",
    "# -------------------------------\n",
    "# Demonstration\n",
    "# -------------------------------\n",
    "\n",
    "# Inventory[str] for product names\n",
    "product_names = Inventory[str]()\n",
    "product_names.store(\"Laptop\")\n",
    "product_names.store(\"Wireless Mouse\")\n",
    "product_names.store(\"Keyboard\")\n",
    "\n",
    "print(\"Product Names\")\n",
    "product_names.display()\n",
    "\n",
    "\n",
    "# Inventory[int] for stock quantities\n",
    "stock_quantities = Inventory[int]()\n",
    "stock_quantities.store(50)\n",
    "stock_quantities.store(120)\n",
    "stock_quantities.store(35)\n",
    "\n",
    "print(\"\\nStock Quantities\")\n",
    "stock_quantities.display()\n",
    "\n",
    "\n",
    "# Inventory[float] for product prices\n",
    "product_prices = Inventory[float]()\n",
    "product_prices.store(2499.99)\n",
    "product_prices.store(49.99)\n",
    "product_prices.store(89.50)\n",
    "\n",
    "print(\"\\nProduct Prices\")\n",
    "product_prices.display()\n",
    "\n",
    "\n",
    "# Inventory[list] for batches of serial numbers\n",
    "serial_batches = Inventory[list]()\n",
    "serial_batches.store([\"SN001\", \"SN002\", \"SN003\"])\n",
    "serial_batches.store([\"SN004\", \"SN005\"])\n",
    "\n",
    "print(\"\\nSerial Number Batches\")\n",
    "serial_batches.display()"
   ],
